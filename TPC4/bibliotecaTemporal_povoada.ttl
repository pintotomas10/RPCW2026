        owl:NamedIndividual .

:LivroHistórico a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Livro [ a owl:Restriction ;
                        owl:allValuesFrom :EventoHistórico ;
                        owl:onProperty :refere ] ) ] .

:LivroFiccional a owl:Class ;
    owl:disjointWith :LivroHistórico ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Livro [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty :refere ;
                                owl:someValuesFrom :EventoHistórico ] ] ) ] .

:LivroParodoxal a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Livro [ a owl:Restriction ;
                        owl:onProperty :existeEm ;
                        owl:someValuesFrom :LinhaAlternativa ] [ a owl:Restriction ;
                        owl:onProperty :existeEm ;
                        owl:someValuesFrom :LinhaOriginal ] ) ] .

