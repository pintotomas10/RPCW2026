:Bibliotecário a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pessoa [ a owl:Restriction ;
                        owl:onClass :Biblioteca ;
                        owl:onProperty :trabalhaEm ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

:EventoHistórico a owl:Class ;
    rdfs:subClassOf :Evento .

