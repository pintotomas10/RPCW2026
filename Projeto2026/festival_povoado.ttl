@prefix : <http://www.semanticweb.org/utilizador/ontologies/2026/festival_da_cancao/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/utilizador/ontologies/2026/festival_da_cancao> a owl:Ontology ;
    rdfs:comment "Uma ontologia sobre o festival da canção" .

:Artist a owl:Class ;
    rdfs:subClassOf :Person .

:belongsToEdition a owl:ObjectProperty ;
    rdfs:domain :Contestant ;
    rdfs:range :FestivalEdition ;
    owl:inverseOf :hasContestant .

:cityName a owl:DatatypeProperty ;
    rdfs:domain :City ;
    rdfs:range xsd:string .

:contestantId a owl:DatatypeProperty ;
    rdfs:domain :Contestant ;
    rdfs:range xsd:string .

:editionYear a owl:DatatypeProperty ;
    rdfs:domain :FestivalEdition ;
    rdfs:range xsd:int .

:eurovisionResult a owl:DatatypeProperty ;
    rdfs:domain :Song ;
    rdfs:range xsd:string .

:hasComposer a owl:ObjectProperty ;
    rdfs:domain :Song ;
    rdfs:range :Composer .

:hasLyricist a owl:ObjectProperty ;
    rdfs:domain :Song ;
    rdfs:range :Lyricist .

:hasMusicDirector a owl:ObjectProperty ;
    rdfs:domain :FestivalEdition ;
    rdfs:range :MusicDirector .

:hasPhase a owl:ObjectProperty ;
    rdfs:domain :FestivalEdition ;
    rdfs:range :FestivalPhase .

:hasPresenter a owl:ObjectProperty ;
    rdfs:domain :FestivalPhase ;
    rdfs:range :Presenter .

:hasWinner a owl:ObjectProperty ;
    rdfs:domain :FestivalEdition ;
    rdfs:range :Song .

:heldAt a owl:ObjectProperty ;
    rdfs:domain :FestivalPhase ;
    rdfs:range :Venue .

:locatedIn a owl:ObjectProperty ;
    rdfs:domain :Venue ;
    rdfs:range :City .

:performedBy a owl:ObjectProperty ;
    rdfs:domain :Song ;
    rdfs:range :Contestant ;
    owl:inverseOf :performsSong .

:personName a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:phaseDate a owl:DatatypeProperty ;
    rdfs:domain :FestivalPhase ;
    rdfs:range xsd:string .

:songTitle a owl:DatatypeProperty ;
    rdfs:domain :Song ;
    rdfs:range xsd:string .

:venueName a owl:DatatypeProperty ;
    rdfs:domain :Venue ;
    rdfs:range xsd:string .

