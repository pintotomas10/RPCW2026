@prefix : <http://www.semanticweb.org/utilizador/ontologies/2026/cinema/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/utilizador/ontologies/2026/cinema/> .

<http://www.semanticweb.org/utilizador/ontologies/2026/cinema> rdf:type owl:Ontology ;
                                                                rdfs:comment "Uma ontologia sobre cinema"@pt .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Atuou
:Atuou rdf:type owl:ObjectProperty ;
       owl:inverseOf :temAtor .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/compôs
:compôs rdf:type owl:ObjectProperty ;
        owl:inverseOf :foiComposta ;
        rdfs:domain :Pessoa ;
        rdfs:range :Obra .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/escreveu
:escreveu rdf:type owl:ObjectProperty ;
          owl:inverseOf :foiEscrita ;
          rdfs:domain :Pessoa ;
          rdfs:range :Obra .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/foiComposta
:foiComposta rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/foiEscrita
:foiEscrita rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/foi_realizado
:foi_realizado rdf:type owl:ObjectProperty ;
               owl:inverseOf :realizou .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/realizou
:realizou rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Pessoa ;
          rdfs:range :Filme .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/representa
:representa rdf:type owl:ObjectProperty ;
            rdfs:domain :Ator ;
            rdfs:range :Personagem .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temArgumento
:temArgumento rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temAtor
:temAtor rdf:type owl:ObjectProperty ;
         rdfs:domain :Filme ;
         rdfs:range :Pessoa .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temGénero
:temGénero rdf:type owl:ObjectProperty ;
           rdfs:domain :Filme ;
           rdfs:range :Género .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temLíngua
:temLíngua rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temPaísOrigem
:temPaísOrigem rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temPersonagem
:temPersonagem rdf:type owl:ObjectProperty ;
               owl:inverseOf :éPersonagem .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temPeçaMusical
:temPeçaMusical rdf:type owl:ObjectProperty ;
                rdfs:domain :Filme ;
                rdfs:range :PeçaMusical .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/éPersonagem
:éPersonagem rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/data
:data rdf:type owl:DatatypeProperty ;
      rdfs:range xsd:string .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/duração
:duração rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:integer .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/temSexo
:temSexo rdf:type owl:DatatypeProperty ;
         rdfs:domain :Pessoa .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/titulo
:titulo rdf:type owl:DatatypeProperty ;
        rdfs:domain :Filme ;
        rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Argumento
:Argumento rdf:type owl:Class ;
           rdfs:subClassOf :Obra .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Ator
:Ator rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :Pessoa
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :Atuou ;
                                                   owl:someValuesFrom :Filme
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf [ rdf:type owl:Class ;
                        owl:unionOf ( :AtorFeminino
                                      :AtorMasculino
                                    )
                      ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/AtorFeminino
:AtorFeminino rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Ator
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :temSexo ;
                                                           owl:hasValue "F"
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/AtorMasculino
:AtorMasculino rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Ator
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :temSexo ;
                                                            owl:hasValue "M"
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Escritor
:Escritor rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :Pessoa
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :escreveu ;
                                                       owl:someValuesFrom [ rdf:type owl:Class ;
                                                                            owl:unionOf ( :Argumento
                                                                                          :Livro
                                                                                        )
                                                                          ]
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Filme
:Filme rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :data ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :duração ;
                         owl:someValuesFrom xsd:integer
                       ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmeAventura
:FilmeAventura rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :temGénero ;
                                                            owl:hasValue :G_Aventura
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmeComedia
:FilmeComedia rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :temGénero ;
                                                           owl:hasValue :G_Comédia
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmeDramático
:FilmeDramático rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :temGénero ;
                                                             owl:hasValue :G_Drama
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmeInfantil
:FilmeInfantil rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :temGénero ;
                                                            owl:hasValue :G_Infantil
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Filme .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmeMusical
:FilmeMusical rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :temGénero ;
                                                           owl:hasValue :G_Musical
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmeRomântico
:FilmeRomântico rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :temGénero ;
                                                             owl:hasValue :G_Romance
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/FilmesInteressantes
:FilmesInteressantes rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :temGénero ;
                                                                  owl:minCardinality "2"^^xsd:nonNegativeInteger
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :temGénero ;
                                           owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                           owl:onClass :Género
                                         ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Género
:Género rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Class ;
                              owl:oneOf ( :G_Aventura
                                          :G_Ação
                                          :G_Comédia
                                          :G_Drama
                                          :G_Ficção
                                          :G_Infantil
                                          :G_Musical
                                          :G_Romance
                                          :G_Terror
                                          :G_Thriller
                                        )
                            ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Livro
:Livro rdf:type owl:Class ;
       rdfs:subClassOf :Obra .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Língua
:Língua rdf:type owl:Class .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Músico
:Músico rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :Pessoa
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :compôs ;
                                                     owl:someValuesFrom :PeçaMusical
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Obra
:Obra rdf:type owl:Class .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/País
:País rdf:type owl:Class .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Personagem
:Personagem rdf:type owl:Class .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Pessoa
:Pessoa rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :AtorFeminino
                                                   :AtorMasculino
                                                 ) ;
                              rdf:type owl:Class
                            ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/PeçaMusical
:PeçaMusical rdf:type owl:Class ;
             rdfs:subClassOf :Obra .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/Realizador
:Realizador rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Pessoa
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :realizou ;
                                                         owl:someValuesFrom :Filme
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] .


###  http://www.semanticweb.org/utilizador/ontologies/2026/cinema/longasMetragens
:longasMetragens rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Filme
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :duração ;
                                                              owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                   owl:onDatatype xsd:integer ;
                                                                                   owl:withRestrictions ( [ xsd:minExclusive 60
                                                                                                          ]
                                                                                                        )
                                                                                 ]
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


